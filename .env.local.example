# Copiar a .env.local y completar con valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (API de Claude) - solo se usa en el servidor
ANTHROPIC_API_KEY=

# Google OAuth / Calendar - solo se usa en el servidor
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra el refresh token de Google Calendar (AES-256-GCM, 32 bytes en base64).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Pasarela de pago (Culqi) - Fase 3B
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
